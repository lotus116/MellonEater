# Copy to .env. This file is read as data, never executed as shell commands.
CHIGUA_PROVIDER=codex
# For DeepSeek, change provider and set the following:
# CHIGUA_PROVIDER=deepseek
# CHIGUA_BASE_URL=https://api.deepseek.com
# CHIGUA_MODEL=deepseek-flash
# CHIGUA_DEEPSEEK_THINKING=disabled
# Optional thinking modes: low / high (reasoning consumes the same output budget).
# CHIGUA_API_KEY=your-key-here
